# Copy to .env (start_coi_tracker.bat does this the first time). Everything has a safe default.
DRY_RUN=true                     # true = no real email; everything goes to the Outbox page
BASE_URL=http://localhost:8010   # sub upload links are built from this
SECRET_KEY=change-me-session-secret
ADMIN_EMAILS=                    # your login email -> /admin (accuracy, renewal rate, customers)

# Claude reads certificates when this is set. Without it the offline reader handles text PDFs only.
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-opus-5-5    # or claude-sonnet-5-5 / claude-haiku-5-5 (cheaper)
REVIEW_CONFIDENCE=0.85           # fields below this go to a human

# Schedule (runs inside the app; or run: .venv\Scripts\python.exe -m coi.worker --once)
AUTO_SCHEDULER=true
WORKER_INTERVAL_SECONDS=900
REMINDER_STAGES=30,14,7,0
DIGEST_WEEKDAY=0                 # 0 = Monday
DIGEST_HOUR=8

# Plans: the operator sets these. stripe_price = Stripe Price ID. max_vendors 0 = no cap.
PLAN_TIERS_JSON=[{"key": "tier1", "label": "Tier 1", "price_text": "$__/mo", "stripe_price": "", "max_vendors": 0}, {"key": "tier2", "label": "Tier 2", "price_text": "$__/mo", "stripe_price": "", "max_vendors": 0}]
FREE_SCAN_MAX_COIS=10
FREE_BULK_UPLOAD=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live email (only after DRY_RUN=false)
EMAIL_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=certificates@example.com
MAILING_ADDRESS=
EMAIL_ALLOWLIST=
